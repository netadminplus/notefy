[MASTER]
# Ignore the fact that we can't find these in the CI environment
ignored-modules=flask,flask_sqlalchemy,flask_migrate,prometheus_flask_exporter,sqlalchemy,app.models

[MESSAGES CONTROL]
# Disable the most annoying "noise" checks
disable=
    C0114, # missing-module-docstring
    C0115, # missing-class-docstring
    C0116, # missing-function-docstring
    C0301, # line-too-long (we use Black for this)
    W1203, # logging-fstring-interpolation (modern Python is fine with this)
    C0411, # wrong-import-order
    C0413, # import-at-top
    C0415, # import-outside-toplevel
    W0718, # broad-exception-caught
    R0401  # cyclic-import (Flask app factory pattern often triggers this)

[FORMAT]
max-line-length=120